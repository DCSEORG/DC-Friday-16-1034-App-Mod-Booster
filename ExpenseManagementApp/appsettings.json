{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:{server}.database.windows.net;Database={database};Authentication=Active Directory Managed Identity;User Id={clientId};"
  },
  "AzureOpenAI": {
    "Endpoint": "https://{resource-name}.openai.azure.com/",
    "DeploymentName": "gpt-4o",
    "ApiVersion": "2024-08-01-preview"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
